generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Gender {
  MEN
  WOMEN
  UNISEX
}

enum DealerStatus {
  PENDING
  DOCS_REVIEW
  VERIFIED
  APPROVED
  REJECTED
}

enum MonthlyDemand {
  D_50_100
  D_101_300
  D_301_500
  D_501_1000
  D_1000_PLUS
}

enum DealerDocType {
  NID_FRONT
  NID_BACK
  FACE_PHOTO
  LOCATION_DOC
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
}

enum PaymentMethod {
  COD
  BKASH
  NAGAD
  CARD
}

enum PaymentStatus {
  UNPAID
  PAID
  REFUNDED
}

enum Role {
  CUSTOMER
  ADMIN
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  phone        String?  @unique
  passwordHash String
  role         Role     @default(CUSTOMER)
  isVerified   Boolean  @default(false)
  addresses    Address[]
  orders       Order[]
  reviews      Review[]
  wishlist     WishlistItem[]
  cart         CartItem[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Address {
  id          String  @id @default(cuid())
  userId      String
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName    String
  phone       String
  district    String
  city        String
  thana       String?
  area        String?
  addressLine String
  postalCode  String?
  isDefault   Boolean @default(false)
  orders      Order[]
  @@index([userId])
}

model Category {
  id           String    @id @default(cuid())
  name         String
  slug         String    @unique
  heroTitle    String
  heroSubtitle String
  heroImage    String
  cardImage    String
  gender       Gender    @default(UNISEX)
  sortOrder    Int       @default(0)
  isActive     Boolean   @default(true)
  products     Product[]
}

model Product {
  id             String   @id @default(cuid())
  name           String
  slug           String   @unique
  sku            String   @unique
  description    String   @db.Text
  material       String
  price          Decimal  @db.Decimal(10, 2)
  compareAtPrice Decimal? @db.Decimal(10, 2)
  categoryId     String
  category       Category @relation(fields: [categoryId], references: [id])
  gender         Gender
  isNewArrival   Boolean  @default(false)
  isBestSeller   Boolean  @default(false)
  isFeatured     Boolean  @default(false)
  isActive       Boolean  @default(true)
  avgRating      Float    @default(0)
  reviewCount    Int      @default(0)
  images         ProductImage[]
  variants       ProductVariant[]
  reviews        Review[]
  cartItems      CartItem[]
  wishlistItems  WishlistItem[]
  orderItems     OrderItem[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  @@index([categoryId])
  @@index([price])
  @@index([avgRating])
  @@index([isNewArrival])
  @@index([isBestSeller])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String?
  colour    String?
  sortOrder Int     @default(0)
  @@index([productId])
}

model ProductVariant {
  id         String  @id @default(cuid())
  productId  String
  product    Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  size       String
  colourName String
  colourHex  String
  stock      Int     @default(0)
  sku        String  @unique
  @@unique([productId, size, colourName])
  @@index([productId])
}

model SizeChartRow {
  id         String  @id @default(cuid())
  chartName  String
  euSize     String
  ukSize     String
  footLength Decimal @db.Decimal(4, 1)
  sortOrder  Int     @default(0)
  @@index([chartName])
}

model Review {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  authorName String
  rating     Int
  body       String   @db.Text
  isApproved Boolean  @default(true)
  createdAt  DateTime @default(now())
  @@index([productId])
  @@index([userId])
}

model CartItem {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId String?
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  variantId String
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  @@index([userId])
  @@index([sessionId])
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@unique([userId, productId])
}

model Order {
  id            String        @id @default(cuid())
  orderNumber   String        @unique
  viewToken     String?       @unique
  userId        String?
  user          User?         @relation(fields: [userId], references: [id])
  addressId     String?
  address       Address?      @relation(fields: [addressId], references: [id])
  guestName     String?
  guestPhone    String?
  guestEmail    String?
  guestAddress  String?
  guestCity     String?
  guestArea     String?
  guestThana    String?
  guestPostalCode String?
  district      String
  subtotal      Decimal       @db.Decimal(10, 2)
  shippingFee   Decimal       @db.Decimal(10, 2)
  discount      Decimal       @db.Decimal(10, 2) @default(0)
  total         Decimal       @db.Decimal(10, 2)
  status        OrderStatus   @default(PENDING)
  paymentMethod PaymentMethod @default(COD)
  paymentStatus PaymentStatus @default(UNPAID)
  notes         String?
  items         OrderItem[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  @@index([userId])
  @@index([status])
}

model OrderItem {
  id          String  @id @default(cuid())
  orderId     String
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String
  product     Product @relation(fields: [productId], references: [id])
  productName String
  size        String
  colourName  String
  unitPrice   Decimal @db.Decimal(10, 2)
  quantity    Int
  @@index([orderId])
}

model SellPackage {
  id           String  @id @default(cuid())
  name         String  @unique // e.g. "Standard Package"
  slug         String  @unique
  minPairs     Int
  maxPairs     Int?
  description  String?
  discountPct  Decimal? @db.Decimal(5, 2)
  sortOrder    Int     @default(0)
  isActive     Boolean @default(true)
  applications DealerApplication[]
  @@index([sortOrder])
}

model DealerApplication {
  id            String        @id @default(cuid())
  refNumber     String        @unique // e.g. "DLR-2026-000123"
  phone         String                 // normalized 01XXXXXXXXX
  businessLoc   String        @db.Text
  packageId     String
  package       SellPackage   @relation(fields: [packageId], references: [id])
  monthlyDemand MonthlyDemand
  status        DealerStatus  @default(PENDING)
  adminNote     String?       @db.Text
  reviewedById  String?
  reviewedAt    DateTime?
  consentAt     DateTime?
  ipAddress     String?
  userAgent     String?
  documents     DealerDocument[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  @@index([status])
  @@index([phone])
  @@index([createdAt])
}

model DealerDocument {
  id            String            @id @default(cuid())
  applicationId String
  application   DealerApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  type          DealerDocType
  storageKey    String            @unique // object key — references an UploadedFile row, NEVER a public URL
  fileName      String
  mimeType      String
  sizeBytes     Int
  uploadedAt    DateTime          @default(now())
  auditLogs     AuditLog[]
  @@index([applicationId])
}

model UploadedFile {
  id         String   @id @default(cuid())
  storageKey String   @unique
  content    Bytes // uploaded image bytes (WebP), stored in Neon/Postgres as bytea
  mimeType   String
  sizeBytes  Int
  createdAt  DateTime @default(now())
}

model DealerBenefit {
  id        String  @id @default(cuid())
  icon      String          // lucide icon name
  title     String
  body      String
  section   String          // "WHY" | "GET"
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)
  @@index([section])
  @@index([isActive])
}

model AuditLog {
  id            String         @id @default(cuid())
  actorId       String
  actorEmail    String
  action        String
  documentId    String
  document      DealerDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  applicationId String?
  storageKey    String?
  ipAddress     String?
  createdAt     DateTime       @default(now())
  @@index([documentId])
  @@index([createdAt])
}

model District {
  id          String  @id @default(cuid())
  name        String  @unique
  division    String
  shippingFee Decimal @db.Decimal(10, 2) @default(120)
}

model HeroSlide {
  id        String  @id @default(cuid())
  titleTop  String
  titleRed  String
  subtitle  String
  ctaLabel  String
  ctaHref   String
  image     String
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)
}

model Testimonial {
  id        String  @id @default(cuid())
  name      String
  role      String
  quote     String  @db.Text
  rating    Int     @default(5)
  avatar    String?
  isActive  Boolean @default(true)
  sortOrder Int     @default(0)
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String
  message   String   @db.Text
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model OtpCode {
  id         String    @id @default(cuid())
  email      String
  codeHash   String
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())
  @@index([email])
}